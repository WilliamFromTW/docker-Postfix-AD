ldap_version = 3
auth_bind = yes

# This tells Dovecot to search all entries that fall below the base entry.
# If it were set to "onelevel", Dovecot would search only entries one levely.
# If it were set to "base", Dovecot would search only the base entry.
scope           = subtree

# If you are referencing and dereferencing aliases,
# then you know a lot more about LDAP than I do.
deref           = never

pass_attrs      = userPassword=password
default_pass_scheme = CRYPT
hosts = HOST_IP:389
base= SEARCH_BASE 
dn = BIND_DN
dnpass = BIND_PW
pass_filter     = (&(objectClass=*)(|(sAMAccountName=%u)(uid=%u)))
user_filter     = (&(objectClass=*)(|(mail=%u)(userPrincipalName=%u)(samaccountname=%u)(uid=%u)))
user_attrs      = =home=/home/vmail/%{ldap:mail}, =mail=maildir:/home/vmail/%{ldap:mail}/Maildir, =sieve=/home/vmail/%{ldap:mail}/sieve/dovecot.sieve, =sieve_dir=/home/vmail/%{ldap:mail}/sieve, =uid=1001, =gid=1001


