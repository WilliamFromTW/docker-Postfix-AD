    <tr>
      <td style="padding: 10px 15px; border-bottom: 1px solid #e9ecef; font-weight: bold;">Límite de cuota asignado:</td>
      <td style="padding: 10px 15px; border-bottom: 1px solid #e9ecef; color: #d9534f; font-weight: bold;">${QUOTA_LIMIT}</td>
